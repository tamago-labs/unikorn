{
  "name": "@tamago-labs/unikorn",
  "version": "0.1.0",
  "description": "Turn any codebase into a verified PRD, tutorial and slide deck with kane-cli",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "unikorn": "dist/index.js"
  },
  "files": [
    "dist",
    "frontend/dist",
    "README.md"
  ],
  "scripts": {
    "dev": "concurrently -n cli,web -c blue,green \"npm run dev:cli\" \"npm run dev:web\"",
    "dev:cli": "tsx src/index.ts",
    "dev:web": "npm --prefix frontend run dev",
    "build": "tsc && npm --prefix frontend run build",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "prd",
    "kane-cli",
    "browser-automation",
    "ai",
    "tutorial",
    "slide-deck",
    "verification",
    "marketing"
  ],
  "dependencies": {
    "express": "^4.21.0",
    "openai": "^7.8.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "concurrently": "^8.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tamago-labs/unikorn.git"
  },
  "homepage": "https://github.com/tamago-labs/unikorn#readme",
  "bugs": {
    "url": "https://github.com/tamago-labs/unikorn/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
